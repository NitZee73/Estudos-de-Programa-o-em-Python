programa
{
	
	funcao inicio()
	{
	real nota1, nota2, notafinal
		escreva("Qual a nota da prova 1 do aluno?: ")
		leia(nota1)
		escreva("Qual a nota da prova 1 do aluno?: ")
		leia(nota2)


		se (((nota1 + nota2) / 2) >= 6){

			escreva("Aprovado")
		}

			senao{
				escreva("Recuperação")
			}
		
	}
}
