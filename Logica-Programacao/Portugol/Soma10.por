programa
{
	
	funcao inicio()
	{
	inteiro numero, soma = 0
		escreva("Insira um número: ")
			leia(numero)

	para (inteiro i = 1; i<=10; i++){

			soma = soma + numero
	}
		escreva("A soma dos  números é: ", soma)
	}
	
}
