programa
{
	
	funcao inicio()
	{
		real base, altura, area
		
		escreva("Insira o valor da base: ")
		leia(base)
		escreva("Insira o valor da altura: ")
		leia(altura)
		area = base * altura
		escreva("A area total é: " , area)
	}
}
