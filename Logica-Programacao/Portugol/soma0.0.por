programa
{
	
	funcao inicio()
	{
	inteiro numero, soma = 0
	
		
		escreva("Digite uma número: ")
		leia(numero)

	enquanto(numero != 0){


		soma = soma + numero
		leia (numero)
	}

		escreva("A soma dos números é: " , soma) 
	
	}
}
