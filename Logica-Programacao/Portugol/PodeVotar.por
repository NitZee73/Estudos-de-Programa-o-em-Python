programa
{
	
	funcao inicio()
	{
	inteiro Datanascimento, Dataatual = 2026

		escreva("Digite o ano de nascimento: ")
		leia(Datanascimento)


		se((Dataatual - Datanascimento) >= 18 ){
			escreva("Pode votar")
		}
		senao
		{
			escreva("Não pode votar")
		}
	}
}
