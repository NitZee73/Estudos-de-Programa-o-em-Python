programa
{
	
	funcao inicio()
	{
		real n
	
          escreva("Digite o valor de n: ")
          leia (n)

	 
	 se (n>0)
	 escreva("O núumero é positivo")

	 senao 
	 escreva("O número é negativo")
	 
	 	
	 
	 
	 
	 }	
}
